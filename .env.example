# ========================================================
# Google Drive Field Work Gallery Configuration
# ========================================================
# Provide comma-separated Google Drive links for verified site treatment photos.
# Set Google Drive sharing permission to: "Anyone with the link to view".
#
# Formats supported:
# 1) Direct file links:
#    VITE_GALLERY_IMAGES="https://drive.google.com/file/d/FILE_ID_1/view, https://drive.google.com/file/d/FILE_ID_2/view"
#
# 2) Custom title with link ("Title | URL"):
#    VITE_GALLERY_IMAGES="Termite Treatment | https://drive.google.com/file/d/FILE_ID_1/view, Kitchen Gel Spray | https://drive.google.com/file/d/FILE_ID_2/view"
#
# 3) Folder link:
#    VITE_GALLERY_IMAGES="https://drive.google.com/drive/folders/FOLDER_ID"
# ========================================================
VITE_GALLERY_IMAGES="https://drive.google.com/file/d/1rrNlnJK7d3ys1fZgmTINkqYwyNP0XlZZ/view, https://drive.google.com/file/d/12i7LPRKypg0ImFQqD-Ud-G0G3gn52IFb/view, https://drive.google.com/file/d/1JURSZJy4SkiM1KWBOXzQDVTHIe-66TF9/view, https://drive.google.com/file/d/18getJXTefi-MOWF9Sw2sSx5agtgNtDWC/view, https://drive.google.com/file/d/1eTG8oRwqeSJqoo_HIw2XTaXhrQOF5OXz/view, https://drive.google.com/file/d/1yIYK8vPWuZerN8Zj278g6pOKO_qBYeqw/view, https://drive.google.com/file/d/1MNxE-bh819YLSGV021e6u-g4f36qq_Iv/view, https://drive.google.com/file/d/1Y5NC2bs9G3QCVaiNoRIBuYcHYHYDZ0_0/view, https://drive.google.com/file/d/1yIYK8vPWuZerN8Zj278g6pOKO_qBYeqw/view"

# ========================================================
# Site URL — used for canonical, og:url and sitemap (no trailing slash)
# ========================================================
SITE_URL="https://globalelitepestmanagement.in"

# ========================================================
# SMTP — contact form notification + customer auto-reply
# ========================================================
# SERVER-SIDE ONLY. Never prefix these with VITE_ — VITE_* values are bundled
# into the public JavaScript and would leak your credentials.
#
# Gmail setup: enable 2-Step Verification, then create an App Password
# (Google Account -> Security -> App passwords) and paste it as SMTP_PASS.
# For Gmail keep SMTP_PORT="587" / SMTP_SECURE="false",
# or use SMTP_PORT="465" / SMTP_SECURE="true".
# ========================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Global Elite Pest Management <your-email@gmail.com>"

# Where new website inquiries are delivered
CONTACT_NOTIFY_TO="your-email@gmail.com"
# "true" sends an automatic thank-you reply to the customer's email
CONTACT_AUTO_REPLY="true"

# Google Business Profile reviews link (leave empty to disable the link).
# VITE_ prefix = client-visible, so only put public URLs here, never secrets.
VITE_GOOGLE_REVIEWS_URL=""
